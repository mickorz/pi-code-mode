{
  "name": "@mickorz/pi-code-mode",
  "version": "0.1.0",
  "description": "面向 Pi Agent 的代码式工作流编排插件：JavaScript DSL 调度多个 Agent、管理执行状态、恢复工作流",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "pi-code-mode": "bin/pi-code-mode.js"
  },
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.extensions.json && node -e \"const fs=require('node:fs');fs.cpSync('src/engine/analyzer/dashboard/template.html','dist/engine/analyzer/dashboard/template.html');fs.cpSync('src/engine/analyzer/rules/definitions','dist/engine/analyzer/rules/definitions',{recursive:true})\"",
    "test:engine": "tsx --test tests/engine/*.test.ts",
    "test:contract": "tsx --test tests/contract/*.test.ts",
    "test:analyzer": "tsx --test tests/analyzer/*.test.ts",
    "test:optimizer": "tsx --test tests/optimizer/*.test.ts",
    "test:governance": "tsx --test tests/governance/*.test.ts",
    "test:plan": "tsx --test tests/plan/*.test.ts",
    "test:evaluator": "tsx --test tests/evaluator/*.test.ts",
    "test:adaptive": "tsx --test tests/adaptive/*.test.ts",
    "test": "npm run test:engine && npm run test:contract && npm run test:analyzer && npm run test:optimizer && npm run test:governance && npm run test:plan && npm run test:evaluator && npm run test:adaptive"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-code-mode.ts"
    ],
    "skills": [
      "./skills/workflow-authoring"
    ]
  },
  "dependencies": {
    "acorn": "^8.16.0",
    "cron-parser": "^5.10.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.3.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
